{
  "manifest_version": 3,
  "name": "URKTV 即時伴奏",
  "version": "0.3.2",
  "description": "在你自己的電腦上，把 URKTV 正在播放的 MV 即時去人聲，產生伴奏給你唱。聲音只在這台電腦處理，不會上傳、不會存檔。",
  "permissions": [
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://urktv.afa0425.workers.dev/*",
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://urktv.afa0425.workers.dev/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "tap.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ort/*",
        "models/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "128": "icon128.png"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}